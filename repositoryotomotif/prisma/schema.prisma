// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MAHASISWA
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  role Role @default(MAHASISWA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dosen {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pembimbingTa TugasAkhir[] @relation ("PembimbingTA")
  pembimbing2Ta TugasAkhir[] @relation ("Pembimbing2TA")
  dosenPa TugasAkhir[] @relation("DosenPA")
  pengujiTa PengujiTugasAkhir[]
  pembimbingPi LaporanPi[] @relation("PembimbingPI")
}

model ProgramStudy {
  id Int @id @default(autoincrement())
  name String 
  degree String
  description String? @db.Text
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tugasAkhirs TugasAkhir[]
  artikelJurnals ArtikelJurnal[]
  @@unique([name, degree])
}

model Ruangan{
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tugasAkhir TugasAkhir[]
}

model TugasAkhir {
  id Int @id @default(autoincrement())
  tahunMasuk Int
  judul String @db.Text
  abstract String?  @db.Text
  mataKuliahRelevan String?

  ruanganId Int?
  pembimbingId Int
  pembimbing2Id Int?
  dosenPaId Int?
  ProgramStudyId Int?

  fileName String?
  filePath String?
  fileSize Int?
  fileType String?

  ruangan Ruangan? @relation(fields: [ruanganId], references: [id])
  pembimbing Dosen @relation("PembimbingTA", fields: [pembimbingId], references: [id])
  pembimbing2 Dosen? @relation("Pembimbing2TA", fields: [pembimbing2Id], references: [id])
  dosenPa Dosen? @relation("DosenPA", fields: [dosenPaId], references: [id])
  programStudy ProgramStudy? @relation(fields: [ProgramStudyId], references: [id])

  mahasiswa Mahasiswa[]
  sdgs SDGs[]
  keywords Keyword[]
  penguji PengujiTugasAkhir[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PeranPenguji {
  KETUA
  SEKRETARIS
  ANGGOTA
}

model PengujiTugasAkhir {
  id Int @id @default(autoincrement())
  tugasAkhirId Int
  dosenId Int
  urutan Int
  peran PeranPenguji

  tugasAkhir TugasAkhir @relation(fields: [tugasAkhirId], references: [id], onDelete: Cascade)
  dosen Dosen @relation(fields: [dosenId], references: [id])

  @@unique([tugasAkhirId, dosenId])
  @@unique([tugasAkhirId, urutan])
}

model SDGs  {
  id Int @id @default(autoincrement())
  code String @unique
  title String 
  description String? @db.Text
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tugasAkhirs TugasAkhir[]
}

model Mahasiswa {
  id Int @id @default(autoincrement())
  name String
  nim String
  urutan Int @default(1)
  tugasAkhirId Int
  tugasAkhir TugasAkhir @relation(fields: [tugasAkhirId], references:[id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tugasAkhirId, nim])

}

model Keyword {
  id Int @id @default(autoincrement())
  kata String

  tugasAkhirId Int
  tugasAkhir TugasAkhir @relation(fields: [tugasAkhirId], references: [id], onDelete: Cascade)
   @@unique([tugasAkhirId, kata])
}

model ArtikelJurnal {
  id Int @id @default(autoincrement())
  name String
  nim String
  tahun Int
  judul String @db.Text
  abstract String @db.Text
  
  ProgramStudyId Int?
  programStudy ProgramStudy? @relation(fields: [ProgramStudyId], references: [id])

  fileName String?
  filePath String?
  fileSize Int?
  fileType String?

  keywords JurnalKeyword[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JurnalKeyword {
  id Int @id @default(autoincrement())
  kata String

  artikelJurnalId Int
  artikelJurnal ArtikelJurnal @relation(fields: [artikelJurnalId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  @@unique([artikelJurnalId, kata])
  
}

model LaporanPi {
  id Int @id @default(autoincrement())
  name String
  nim String
  namaInstansi String

  dosenPembimbingId Int
  dosenPembimbing Dosen @relation("PembimbingPI", fields: [dosenPembimbingId], references: [id])

  tanggalMulai DateTime
  tanggalSelesai DateTime

  fileName String
  filePath String
  fileSize Int
  fileType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}